# =============================================================================
# nexus-ai — environment configuration
# Copy this file to .env and fill in your values
# =============================================================================

# ----- LLM Provider -----
# OpenAI (recommended to start)
OPENAI_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# Optional: fallback providers (uncomment if used)
# ANTHROPIC_API_KEY=sk-ant-...
# OLLAMA_BASE_URL=http://localhost:11434

# ----- API -----
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ----- Database -----
DATABASE_URL=sqlite+aiosqlite:///./nexus.db

# ----- Vector DB (ChromaDB) -----
CHROMA_PERSIST_DIR=./chroma

# ----- Security -----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000

# ----- Tool APIs -----
# Tavily (recommended for web search — free tier: 1000 queries/month)
TAVILY_API_KEY=

# ----- Logging -----
LOG_LEVEL=INFO
LOG_FORMAT=json

# ----- Sandbox -----
CODE_EXEC_TIMEOUT_SECONDS=10
CODE_EXEC_MAX_OUTPUT_BYTES=10000
